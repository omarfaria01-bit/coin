# Copy to .env (never commit .env). chmod 600 .env
# Read-only RPC (mainnet reads are allowed; writes are not)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Optional, only if kiwi provides one
HELIUS_API_KEY=
# Optional, only if kiwi provides one with a hard spend cap
XAI_API_KEY=
# Treasury bot: paper | devnet | live (live needs kiwi's APPROVED)
BOT_MODE=paper
